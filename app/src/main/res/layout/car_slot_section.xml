<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/car_slots_hint"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />
        <Button
            android:id="@+id/btnShowMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/show_on_map" />

        <!-- Row 1: C1, C2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot1" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C1" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C1" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot2" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C2" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginStart="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C2" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <!-- Row 2: C3, C4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot3" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C3" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C3" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot4" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C4" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginStart="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C4" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <!-- Row 3: C5, C6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot5" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C5" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C5" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot6" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C6" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginStart="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C6" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <!-- Row 4: C7, C8 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot7" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C7" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C7" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot8" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C8" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginStart="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C8" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <!-- Row 5: C9, C10 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot9" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C9" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C9" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/ivCarSlot10" android:layout_width="140dp" android:layout_height="140dp" android:contentDescription="Car slot C10" android:padding="16dp" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginStart="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C10" android:textSize="16sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
